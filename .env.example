# Variables de entorno de Publi Marketing.
# Copiar este archivo como .env y completar con valores reales (nunca se commitea .env).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=

# Cadena de conexion a PostgreSQL (Supabase > Project Settings > Database > Connection string > URI).
# Recomendada tambien en desarrollo; si se deja vacia aqui, la app usa
# automaticamente una base SQLite local (instance/dev.db) como fallback
# explicito de desarrollo.
# En produccion (FLASK_ENV=production) es OBLIGATORIA: la app se niega a
# arrancar sin ella (nunca cae en SQLite en produccion).
DATABASE_URL=

# Clave usada por Flask para firmar la sesion. Genera una propia (no uses la de ejemplo en produccion).
SECRET_KEY=

# development o production
FLASK_ENV=development

# --- Datos de Meta (Paso 1) -----------------------------------------
# App de Meta for Developers (developers.facebook.com/apps). Sin estas
# tres variables, el boton "Conectar Meta" muestra un estado honesto
# de "no configurado" en vez de fallar o simular una conexion.
META_APP_ID=
META_APP_SECRET=
# URL publica de esta app + /datos-meta/conexiones/callback
# (ej. https://tu-app.up.railway.app/datos-meta/conexiones/callback)
META_REDIRECT_URI=
# Version de la Graph API a usar -- verificar la version vigente en
# https://developers.facebook.com/docs/graph-api/changelog antes de
# desplegar (Meta retira versiones antiguas periodicamente).
META_API_VERSION=v21.0

# Clave Fernet para cifrar tokens de Meta en reposo (ver app/core/crypto.py).
# Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OBLIGATORIA en produccion -- la app se niega a guardar un token de Meta sin ella.
META_TOKEN_ENCRYPTION_KEY=

# Identificador de la configuracion de "Registro insertado de WhatsApp"
# (Embedded Signup, incluida Coexistencia) creada en Meta App Dashboard >
# Inicio de sesion con Facebook para empresas > Plantillas. Reutiliza
# META_APP_ID/META_APP_SECRET de arriba -- no es una app de Meta
# distinta. Sin esta variable, el boton "Conectar con WhatsApp
# (recomendado)" simplemente no aparece y solo queda el formulario manual.
META_WHATSAPP_CONFIG_ID=

# --- Estratega IA (Paso 10) ------------------------------------------
# API key de Anthropic (console.anthropic.com). Sin esta variable, la
# pantalla Marketing > Estratega IA funciona igual (conversaciones,
# contexto automatico) pero muestra un aviso honesto de "no
# configurado" en vez de simular una respuesta.
ANTHROPIC_API_KEY=

# Opcionales -- limites de uso para evitar consumo accidental (Paso 10,
# punto 14). Si se dejan vacios, se usan los valores por defecto del
# codigo (ver app/services/estratega_ia.py).
IA_LIMITE_MENSAJES_POR_CONVERSACION=
IA_LIMITE_MENSAJES_DIARIOS_POR_EMPRESA=

# Opcionales -- tarifa real contratada con Anthropic, en USD por millon
# de tokens. Sin estas dos variables, el costo estimado de cada mensaje
# se guarda como "no disponible" en vez de inventar un numero.
IA_PRECIO_ENTRADA_USD_POR_1M=
IA_PRECIO_SALIDA_USD_POR_1M=
